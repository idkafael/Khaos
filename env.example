# Configurações do Bot Discord
DISCORD_TOKEN=seu_token_do_discord_aqui
DISCORD_APPLICATION_ID=seu_application_id_aqui

# Configurações do Supabase
SUPABASE_URL=sua_url_do_supabase_aqui
SUPABASE_KEY=sua_chave_do_supabase_aqui

# Configurações da API PushinPay
PUSHINPAY_API_KEY=sua_chave_da_pushinpay_aqui
PUSHINPAY_WEBHOOK_SECRET=seu_webhook_secret_aqui
PUSHINPAY_SANDBOX=true
WEBHOOK_BASE_URL=https://seu-dominio.com

# Configurações opcionais
BOT_PREFIX=!
BOT_OWNER_ID=123456789
PAYMENT_TIMEOUT_MINUTES=10
PAYMENT_CHECK_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
LOG_FILE=bot.log
ENVIRONMENT=development

# Servidor Webhook (para receber notificações PushinPay)
WEBHOOK_PORT=8080
WEBHOOK_URL=https://seu-dominio.com/webhook/pushinpay